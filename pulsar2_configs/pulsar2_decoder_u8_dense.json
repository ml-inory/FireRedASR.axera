  "input_processors": [
    {"tensor_name": "tokens", "src_dtype": "S32"},
    {"tensor_name": "in_n_layer_self_k_cache", "src_dtype": "FP32"},
    {"tensor_name": "in_n_layer_self_v_cache", "src_dtype": "FP32"},
    {"tensor_name": "n_layer_cross_k", "src_dtype": "FP32"},
    {"tensor_name": "n_layer_cross_v", "src_dtype": "FP32"},
    {"tensor_name": "pe", "src_dtype": "FP32"},
    {"tensor_name": "self_attn_mask", "src_dtype": "FP32"},
    {"tensor_name": "cross_attn_mask", "src_dtype": "FP32"}
  ],
  "compiler": {"check": 0}
