  "target_hardware": "AX650",
  "npu_mode": "NPU3",
  "input_shapes": "tokens:1x1;in_n_layer_self_k_cache:16x1x128x1280;in_n_layer_self_v_cache:16x1x128x1280;n_layer_cross_k:16x1x250x1280;n_layer_cross_v:16x1x250x1280;pe:1280;self_attn_mask:1x1x128;cross_attn_mask:1x1x250",
  "onnx_opt": {
    "disable_onnx_optimization": true,
    "enable_onnxsim": false,
    "model_check": true
  },
  "quant": {
    "input_configs": [
      {"tensor_name": "tokens", "calibration_dataset": "./calib_data/tokens.tar.gz", "calibration_format": "Numpy", "calibration_size": -1},
      {"tensor_name": "in_n_layer_self_k_cache", "calibration_dataset": "./calib_data/in_n_layer_self_k_cache.tar.gz", "calibration_format": "Numpy", "calibration_size": -1},
      {"tensor_name": "in_n_layer_self_v_cache", "calibration_dataset": "./calib_data/in_n_layer_self_v_cache.tar.gz", "calibration_format": "Numpy", "calibration_size": -1},
      {"tensor_name": "n_layer_cross_k", "calibration_dataset": "./calib_data/n_layer_cross_k.tar.gz", "calibration_format": "Numpy", "calibration_size": -1},
      {"tensor_name": "n_layer_cross_v", "calibration_dataset": "./calib_data/n_layer_cross_v.tar.gz", "calibration_format": "Numpy", "calibration_size": -1},
      {"tensor_name": "pe", "calibration_dataset": "./calib_data/pe.tar.gz", "calibration_format": "Numpy", "calibration_size": -1},
      {"tensor_name": "self_attn_mask", "calibration_dataset": "./calib_data/self_attn_mask.tar.gz", "calibration_format": "Numpy", "calibration_size": -1},
      {"tensor_name": "cross_attn_mask", "calibration_dataset": "./calib_data/cross_attn_mask.tar.gz", "calibration_format": "Numpy", "calibration_size": -1}
    ],
    "layer_configs": [
      {"start_tensor_names": ["DEFAULT"], "end_tensor_names": ["DEFAULT"], "data_type": "U8"},
      {"op_types": ["Transpose", "Reshape", "Concat"], "data_type": "FP32"}
